# ══════════════════════════════════════════════════════
# Frontend (Next.js) — .env.example
# Хэрэглэх: хуулж .env.local гэж нэрлэнэ (local dev)
# Vercel дээр: Project Settings → Environment Variables
# ══════════════════════════════════════════════════════

# Backend API base URL (заавал /api төгсгөлтэй)
# Local:    http://localhost:5000/api
# Render:   https://your-api.onrender.com/api
NEXT_PUBLIC_API_URL=https://malchingeree-api.onrender.com/api

# QR verify хуудсан дээр blockchain explorer link (optional)
# NEXT_PUBLIC_BLOCKCHAIN_EXPLORER=https://example.com/explorer
