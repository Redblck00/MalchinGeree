# ══════════════════════════════════════════════════════
# Backend — .env.example
# Хэрэглэх: энэ файлыг хуулж .env гэж нэрлэнэ, утгуудыг бөглөнө.
# Жинхэнэ .env файлыг git-д commit хийхгүй!
# ══════════════════════════════════════════════════════

# ── Сервер ────────────────────────────────────────────
PORT=5000
# Frontend URL (CORS + invite/verify email link)
# Local:    http://localhost:3000
# Vercel:   https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# ── PostgreSQL ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=e_contract
DB_USER=postgres
DB_PASSWORD=your_db_password
# Зарим platform (Render/Railway) зөвхөн DATABASE_URL ашиглана — дээрх DB_*-тэй ижил утга
DATABASE_URL=postgres://postgres:your_db_password@localhost:5432/e_contract

# ── JWT ───────────────────────────────────────────────
# Заавал 32+ тэмдэгт — production-д шинэ random string ашиглана
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h

# ── OTP / Email (Gmail App Password) ─────────────────
# Google Account → Security → 2-Step → App passwords
OTP_EXPIRES_MIN=15
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── Cloudinary ────────────────────────────────────────
# Профайл зураг: econtract/profiles
# Гэрээний хавсралт: econtract/attachments
# https://console.cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Blockchain (optional — одоогоор дотоод ledger ашиглана) ──
BLOCKCHAIN_NETWORK=
BLOCKCHAIN_RPC_URL=
WALLET_PRIVATE_KEY=
CONTRACT_ADDRESS=
