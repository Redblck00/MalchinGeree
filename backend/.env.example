# ══════════════════════════════════════════════════════
# Backend — .env.example
# Хэрэглэх: энэ файлыг хуулж .env гэж нэрлэнэ, утгуудыг бөглөнө.
# Жинхэнэ .env файлыг git-д commit хийхгүй!
# ══════════════════════════════════════════════════════

# ── Сервер ────────────────────────────────────────────
PORT=5000
# Frontend URL (CORS + invite/verify email link)
# Local:    http://localhost:3000
# Vercel:   https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# ── PostgreSQL ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=e_contract
DB_USER=postgres
DB_PASSWORD=your_db_password
# Зарим platform (Render/Railway) зөвхөн DATABASE_URL ашиглана — дээрх DB_*-тэй ижил утга
DATABASE_URL=postgres://postgres:your_db_password@localhost:5432/e_contract

# ── JWT ───────────────────────────────────────────────
# Заавал 32+ тэмдэгт — production-д шинэ random string ашиглана
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h

# ── OTP / Email (Brevo HTTP API) ─────────────────────
# Render free instance гадагшаа SMTP порт хаадаг тул Gmail/SMTP ажиллахгүй.
# Brevo (https://app.brevo.com) ашиглана — HTTPS дээр явдаг тул Render дээр ажиллана.
#   1) Бүртгүүл → Settings → SMTP & API → Generate a new API key
#   2) Senders & IP → шинэ sender нэмж имэйлээ баталгаажуул (домэйн шаардахгүй)
OTP_EXPIRES_MIN=15
BREVO_API_KEY=your_brevo_api_key
# Brevo дээр баталгаажсан илгээгчийн имэйл (жишээ: your@gmail.com)
EMAIL_FROM=your_verified_sender@gmail.com

# ── Cloudinary ────────────────────────────────────────
# Профайл зураг: econtract/profiles
# Гэрээний хавсралт: econtract/attachments
# https://console.cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Blockchain ───────────────────────────────────────
# BLOCKCHAIN_MODE=simulation → зөвхөн дотоод SHA-256 hash chain (DB) ашиглана.
# BLOCKCHAIN_MODE=testnet     → гэрээний hash-ыг жинхэнэ EVM testnet рүү анкорлоно
#                               (DB ledger хэвээр + дээр нь on-chain tx hash).
BLOCKCHAIN_MODE=simulation
# testnet горимд шаардлагатай:
#   1) Polygon Amoy RPC — https://www.alchemy.com эсвэл нийтийн: https://rpc-amoy.polygon.technology
#   2) Faucet-аас цэнэглэсэн testnet хэтэвчний private key — https://faucet.polygon.technology
BLOCKCHAIN_NETWORK=amoy
BLOCKCHAIN_RPC_URL=
WALLET_PRIVATE_KEY=
# (Сонголтоор) custom anchor smart contract хаяг — энгийн self-tx-д шаардлагагүй
CONTRACT_ADDRESS=
